generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  TUTOR
  ADMIN
}

enum AccountStatus {
  PENDING
  APPROVED
  SUSPENDED
  BANNED
}

enum GradeLevel {
  GRADE_8
  GRADE_9
  GRADE_10
  GRADE_11
  GRADE_12
}

enum LearningPackageType {
  SINGLE_COURSE
  FULL_GRADE
  ENTRANCE_GRADE_9_12
}
